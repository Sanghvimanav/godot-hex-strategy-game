[node name="llm_learnings_row" type="HBoxContainer" parent="center/panel/margin/vbox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="llm_clear_learnings_btn" type="Button" parent="center/panel/margin/vbox/llm_learnings_row"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "Clear post-match AI learnings"
tooltip_text = "Deletes all .md files under user://ai_learnings/ (rolling distill and match archives). Confirm to proceed."

[node name="llm_status" type="Label" parent="center/panel/margin/vbox"]
layout_mode = 2
theme_type_variation = &"UiHint"
text = " "
autowrap_mode = 3

[node name="LlmHttpRequest" type="HTTPRequest" parent="."]
timeout = 60.0

[node name="LlmClearLearningsConfirm" type="ConfirmationDialog" parent="."]
title = "Clear AI learnings"
ok_button_text = "Clear"
dialog_text = "Remove all saved post-match AI learnings? This deletes every .md file under user://ai_learnings/ (including the rolling distill and per-match archives). This cannot be undone."
